# Google Gemini API Key (Recommended) - Get from https://aistudio.google.com
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# OpenAI API Key (Alternative) - Optional
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Tavily Search API Key - Optional (Falls back to zero-key Wikipedia/Open Web search if omitted)
TAVILY_API_KEY=your_tavily_api_key_here

# LangGraph Cyclic Loop Parameters
MAX_REVISIONS=3

# LangSmith Observability - Optional
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=Agentic-DeepResearch
